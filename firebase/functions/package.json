{
  "name": "glimmer-grove-functions",
  "description": "Server-authoritative economy for Glimmer Grove",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "npm run build && node test/reward-vectors.mjs && node test/ad-callback.mjs",
    "seed": "npm run build && node ../seed/seed-config.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.7.2"
  }
}
