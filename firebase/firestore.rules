rules_version = '2';

// Glimmer Grove — Firestore security rules.
//
// These rules are the security boundary of the economy. Not the C# client, not the
// Cloud Functions: this file. Everything else can be decompiled, patched or replayed
// by anyone holding the device, so any invariant that matters has to be expressed
// here or on a server the player cannot reach.
//
// The layout exists to make that boundary trivial to audit. The save document and the
// currency ledger are separate documents with separate rules, rather than one document
// whose currency fields have to be diffed field by field on every write. A rule that
// says "this document is server-only" is one line and cannot be got subtly wrong.
//
//   players/{uid}                    the save. Client reads and writes it.
//   players/{uid}/private/wallet     granted and spent baselines. Client reads only.
//   players/{uid}/spendLog/{id}      idempotency records for debits. Client reads only.
//   players/{uid}/grantLog/{id}      idempotency records for awards. Client reads only.
//   receipts/{store}__{txn}          global receipt claims. Client cannot see them.
//   groves/{uid}                     a keeper's public card. Any player reads, none write.
//   names/{nameKey}                  a reserved keeper name. Any player gets one, none list.
//   nameReports/{uid}/...            who reported whose name. Server-only, both ways.
//   groveReports/{uid}/...           grove reports filed while the Grovement stood. Server-only.
//   leaderboards/{boardId}           a published board. Any player reads, none write.
//   config/{doc}                     reward table and product catalog. Read-only.
//   config/release                   the minimum client per store. World-readable.
//
// What these rules deliberately do NOT do: validate the contents of the level ledger
// element by element. Firestore rules have no loops, so per-record checks are not
// expressible here. That validation lives in the wallet functions, which recompute
// earned currency from the ledger in TypeScript and ignore anything they cannot
// verify. The consequence is the important one: a player who forges their save can
// change what their own progress screen says, and cannot mint a single credit.
//
// `levels` is a map keyed by level id rather than an array. That makes a duplicated
// record impossible to express rather than something the server has to filter, and it
// lets a sync write `levels.c01_first_light` alone instead of re-uploading a ledger
// that may run to thousands of entries.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------- the save
    match /players/{uid} {

      // ---- The evaluation budget. READ THIS BEFORE ADDING A CLAUSE. ----
      //
      // Firestore evaluates at most 1,000 expressions per request and refuses anything past
      // that as PERMISSION_DENIED - on the device indistinguishable from a malformed save, and
      // fatal the same way: every write of that account is refused until the rules change
      // (invariant 12c). Every clause below is paid on every save write, and the account that
      // pays for the most is the longest-played one, because it carries the most optional keys.
      // On 2026-10-25 that account crossed the cap: the v47 build-stamp clauses landed on a
      // ruleset already two expressions from it.
      //
      // So the shape is chosen for cost as well as for clarity:
      //
      //   - an optional key is read once, through `get` with a default that passes its own
      //     check, rather than tested with `in` and then read again: absent and well-formed are
      //     one path, and a present value is checked exactly as strictly as before;
      //   - a bounded list is `listOf(value, N)` and nothing else, which is also the one shape
      //     `CloudWireTests` reads every bound out of (12b);
      //   - a nested block is bound to a `let` once, rather than re-walked from `d`.
      //
      // And the cost is measured, never estimated: `node firebase/e2e/rules-budget.mjs` runs the
      // heaviest save these rules can accept - derived from this text, so a new clause is priced
      // the moment it is written - through Firestore's own engine and fails below 250
      // expressions of headroom. It runs before every rules deploy.

      // A list no longer than `n`. The one way a list is bounded here.
      function listOf(value, n) {
        return value is list && value.size() <= n;
      }

      // A whole number in `[lo, hi]`.
      function intIn(value, lo, hi) {
        return value is int && value >= lo && value <= hi;
      }

      // One task period: a key and two bounded lists. See the `tasks` clause below.
      function taskPeriod(p) {
        return p is map
               && listOf(p.get('counts', []), 32)
               && listOf(p.get('claimed', []), 32);
      }

      // Shape checks only. Anything expensive or unbounded is the functions' job.
      function wellFormed() {
        let d = request.resource.data;
        let ads = d.get('ads', {});
        let tasks = d.get('tasks', {});
        let welcome = tasks.get('welcome', {});
        let challenges = d.get('challenges', {});

        // `hasOnly` is an allow-list over the *whole* document: a key the client writes and this
        // list does not name loses every save write, not that field (12a), so a new top-level
        // key ships here before the client that writes it. A key leaves only once no document
        // holds it and no client the update wall admits writes it (16z).
        return d.keys().hasOnly([
                 'schemaVersion', 'updatedUnix', 'settings', 'wallet', 'levels',
                 'progression', 'cloud', 'lastPlayedLevelId', 'legacyImportDone',
                 'tipsSeen', 'daily', 'ads', 'streak', 'events', 'eventsSeeded',
                 'companionsOwned',
                 'heartContainersOwned', 'heartContainersRevoked',
                 'utilityStock',
                 'wardsOwned', 'wardLoadout', 'wardLoadoutSetUnix',
                 'endlessBest',
                 'shuffleBest',
                 'firstBuild', 'lastBuild',
                 'wardStars',
                 'tasks',
                 'challenges',
                 'checksum'
               ])
               && d.schemaVersion is int
               && d.schemaVersion >= 1 && d.schemaVersion <= 100
               && d.levels is map
               && d.levels.size() <= 5000
               && d.get('lastPlayedLevelId', '') is string
               // Which lessons the player has been shown. Client-owned and harmless - it buys
               // nothing - but bounded, because an unbounded array the client controls makes the
               // document expensive to read. The bound was 64 until 2026-09-16, when the owner's
               // own account crossed it and the rules refused every save it wrote (12a); it now
               // matches `TipLedger.MaxIds`, which the client prunes to before writing.
               && listOf(d.get('tipsSeen', []), 256)
               // Today's chest counters. Forgeable and accounted for: the server re-rolls each
               // chest and refuses a second grant for the same id, so a forged counter buys a
               // day's chests without playing for them - what an honest player gets anyway.
               && d.get('daily', {}) is map
               // Today's rewarded-ad allowance. Forgeable the same way and accounted for the same
               // way: an ad is paid by the server when the network's signed callback arrives, so a
               // forged counter buys another offer and no currency.
               && ads is map
               && listOf(ads.get('watched', []), 64)
               // The streak's dates. A night pays from the server's own record of the last night
               // it paid (functions/src/streak.ts), so editing these buys no money.
               && d.get('streak', {}) is map
               // How much of each event's track the player has taken. This one *does* reach a
               // payment - `eventCredits` reads the floor - and is safe to let the client write
               // because that function clamps it to the glades the same derivation counted
               // (invariant 13, `EventCollection`).
               && listOf(d.get('events', []), 256)
               && d.get('eventsSeeded', false) is bool
               // The companions bought. A forged entry buys a portrait and nothing else; the money
               // half is defended by `submitSpends` refusing a debit the derived balance cannot
               // cover. The roster is inert (16ab) and the key stays until it is retired on purpose.
               && listOf(d.get('companionsOwned', []), 256)
               // The heart containers bought with real money, and the ones a refund took back. A
               // forged container buys faster hearts and nothing else; the refund is the server's,
               // written on its own wallet document and reported on every reply, so an edit here
               // can only take a container from the player who made it.
               && listOf(d.get('heartContainersOwned', []), 32)
               && listOf(d.get('heartContainersRevoked', []), 32)
               // Utilities. Generous against `UtilityCatalog.MaxItems` so a content drop never
               // needs a rules deploy; the bound matches `UtilityStock.MaxIds`.
               && listOf(d.get('utilityStock', []), 64)
               // The tasks: two periods (a key, per-goal counts, claimed ids), the lifetime tally
               // (v32, `LifetimeTally.MaxGoals`), the welcome bonus (v40, `WelcomeLedger.MaxRows`),
               // the deals already shown as a popup (v41, `DealSeen.MaxIds`, 60c) and the first
               // steps (v46, `FirstStepsLedger.MaxEarned` / `MaxTaken`). Shape only: a task chest
               // is bounded by the wallet's per-period allowance in `claimAwards`, a welcome prize
               // buys no currency, and a step's chests are re-rolled and proved against `levels`.
               // Sub-keys are not allow-listed, so a new row inside this map ships in either order
               // with the client (12a's cheap half).
               && tasks is map
               && taskPeriod(tasks.get('daily', {}))
               && taskPeriod(tasks.get('weekly', {}))
               && listOf(tasks.get('lifetime', []), 32)
               && welcome is map
               && listOf(welcome.get('days', []), 8)
               && listOf(welcome.get('claimed', []), 8)
               && listOf(welcome.get('coined', []), 8)
               && listOf(tasks.get('dealsSeen', []), 64)
               && listOf(tasks.get('stepsEarned', []), 16)
               && listOf(tasks.get('stepsTaken', []), 64)
               // The turrets bought and the line they stand in. A forged turret buys a silhouette
               // and nothing that pays; the money half is `submitSpends`'. A row is a turret and a
               // colour (`WardHolding`), so the ceiling is four times `WardCatalog.MaxModels`.
               && listOf(d.get('wardsOwned', []), 160)
               && listOf(d.get('wardLoadout', []), 8)
               && d.get('wardLoadoutSetUnix', 0) is int
               // The best wave per level on the Infinite lane and on the Shuffle lane. Each pays
               // nothing and is the one public figure the server cannot recompute, so it is
               // bounded where it is published (`bestWave`, `shuffleWave`, `MAX_WAVE`, 19l). A row's
               // `waves` tally (v30) pays XP inside a bound and is never published. Bounds match
               // `EndlessLedger.MaxRows` and `ShuffleLedger.MaxRows`.
               && listOf(d.get('endlessBest', []), 64)
               && listOf(d.get('shuffleBest', []), 64)
               // The oldest and newest build this account has run (v47, `BuildStamp`), as
               // `AppVersion`'s integer (1.1.3 is 10103), nought for none. Analytics; buys nothing.
               // The ceiling is 99.99.99, which `BuildStamp.MaxBuild` matches.
               && intIn(d.get('firstBuild', 0), 0, 999999)
               && intIn(d.get('lastBuild', 0), 0, 999999)
               // How far each turret has been upgraded; matches `WardStarLedger.MaxRows`.
               && listOf(d.get('wardStars', []), 128)
               // The daily challenges (v34): today's plays per genre, the lifetime clears per genre
               // and the day each deal was last bought. Shape only - every coin past the free
               // allowance is priced by `claimAwards` against the deal recorded on the wallet. Bounds
               // match `ChallengeLedger.MaxTodayRows` / `MaxClearRows` / `MaxTierRows`.
               && challenges is map
               && listOf(challenges.get('today', []), 32)
               && listOf(challenges.get('clears', []), 64)
               && listOf(challenges.get('tiers', []), 16);
      }

      // The revision only ever moves forward, which gives the sync optimistic
      // concurrency for free. It is >= rather than > so that retrying a push whose
      // response was lost succeeds instead of wedging the device.
      function revisionAdvances() {
        return !('cloud' in resource.data)
               || !('revision' in resource.data.cloud)
               || (request.resource.data.cloud.revision is int
                   && request.resource.data.cloud.revision >= resource.data.cloud.revision);
      }

      // Documents are capped so one account cannot be used to store arbitrary data.
      // A full ledger for a 500-glade catalog is a few tens of kilobytes.
      function withinSize() {
        return request.resource.data.levels.size() <= 5000;
      }

      allow get, list: if isOwner(uid);
      allow create:    if isOwner(uid) && wellFormed() && withinSize();
      allow update:    if isOwner(uid) && wellFormed() && withinSize() && revisionAdvances();

      // Account deletion is a support and compliance operation, never a client call.
      allow delete: if false;

      // --------------------------------------------------- server-owned money
      // The single most important rule in the file. `granted` is what an attacker
      // actually wants: a client that can raise it can print currency, and with real
      // purchases in play that is indistinguishable from stealing revenue. Only the
      // Admin SDK — which these rules do not apply to — may write here.
      match /private/{document} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // Debit idempotency records. Written by the wallet function so that submitting
      // the same spend id twice can only ever charge once.
      match /spendLog/{spendId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // Award idempotency records, written by claimAwards. The id is derived from what
      // earned the award — daily:{day}:{chest}:{currency} — rather than generated, so a
      // second claim from any device, after any reinstall, hits a document that already
      // exists. That, and not any check in the client, is what makes a daily chest
      // payable exactly once.
      match /grantLog/{grantId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
    }

    // ------------------------------------------------------- the public boards
    // A keeper's public card (the spelling is permanent, 16y). This collection exists so that
    // the save document never has to be readable by anyone but its owner: `players/{uid}`
    // holds the level ledger, the streak's dates, the event floors and the ad allowance, and a
    // board needs a name, a level, a badge and a wave. Widening the save's read rule to serve
    // that would publish everything else with it and make the save's shape a public API that
    // could never change again.
    //
    // Server-written, without exception. Every figure on a card is recomputed or bounded by
    // `publishGrove` from the save it reads with admin credentials — see
    // functions/src/grove.ts. Letting a client write here would hand it the boards, because
    // everything a card is built from is client-written and forgeable by design, which is why
    // this is the one place the client is refused write access to something built entirely
    // out of its own save.
    //
    // Readable by any signed-in player, and only by a signed-in player. It carries a
    // display name, so it is not world-readable the way `config/release` is. Nothing here
    // is needed before a player is in the game.
    //
    // `get` and never `list`, for the reason `names` gives below and with more at stake:
    // a card is read by uid (a profile, a board row tapped), and nothing in the client or
    // the e2e suite ever queries the collection. A `list` grant here lets any anonymous
    // sign-in run one query over every published card in the game and bill this project a
    // read per card, as often as it likes — the only read in these rules whose cost would
    // have grown with the size of the collection rather than with the number of players.
    match /groves/{uid} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // The published boards: one document each, holding up to a hundred rows.
    //
    // Denormalised rather than queried, and that is a cost decision that does not move as
    // the game grows. The obvious shape — order the player collection by wave and take
    // the first hundred — is a hundred document reads every time anybody opens the screen,
    // against a collection that grows for the life of the game, on a database billed per
    // read. One document is one read, the same for everybody, and cacheable.
    //
    // `get` only, as `groves`: a board is opened by its id (`LeaderboardBoard.IsKnown`
    // refuses any other), and a collection nobody lists is a collection nobody should be
    // allowed to. The collection is two documents today, so this is least privilege rather
    // than a bill — but a rule is the cheapest place to keep that true.
    match /leaderboards/{boardId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // --------------------------------------------------------- keeper names
    // One document per reserved name, keyed by the name's fold — see functions/src/names.ts.
    //
    // The id *is* the uniqueness. A create against an id that already exists fails, so two
    // players cannot take one name however close together they try, with no index and no
    // scan behind it. The alternative — query the player collection for a matching name and
    // then write — is racy in a way nothing can repair afterwards, and is an index over a
    // collection that grows for the life of the game.
    //
    // `get` and deliberately not `list`. A player may ask whether one name they have typed is
    // free, which is the whole client interaction and is one document read; nobody may walk
    // the collection. That distinction is why the "is this taken" hint costs no function
    // invocation and can be debounced on a keystroke without becoming a bill.
    //
    // Never client-written, even though rules could nearly express it: `create` is already
    // create-if-absent and the uid could be checked against the caller. What rules cannot
    // express is *one name per account*, because that needs the previous reservation released
    // in the same operation and its other half is a document the client itself writes. Without
    // that, one account holds as many names as it cares to pay writes for.
    // A reservation is never released when a name is taken off the boards, only flagged --
    // and the flag lives on the account's wallet rather than here, so this document is exactly
    // what it always was. That is what stops a reported name being handed to the next person
    // who asks for it. See functions/src/reports.ts.
    match /names/{nameKey} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // ------------------------------------------------------------- reports
    // Who has reported whose keeper name, and how many distinct players have. (`groveReports`
    // holds the reports filed while a card still published an arrangement; no new one is
    // written — functions/src/reports.ts.)
    //
    // Server-only in **both** directions, which is unusual here and deliberate in each.
    //
    // Not client-written, for the reason `names` is not: the constraint that matters is "one
    // report per player per name", and while an id of `nameReports/{target}/reporters/{caller}`
    // does express exactly that in rules, the *count* the threshold reads cannot be maintained
    // alongside it by a client without letting the client write the count. A takedown decided
    // by a number the client writes is a takedown anybody can trigger. `reportKeeperName` does
    // both halves in one transaction instead, with a per-account daily quota the rules could
    // not express at all.
    //
    // Not client-*readable*, which matters more than it looks. A caller who can see the count
    // can binary-search the threshold and learn exactly how many accounts a brigade needs; a
    // caller who can read the reporter documents learns who reported them, which turns a safety
    // feature into a way of finding somebody to retaliate against. The callable tells a client
    // only whether its own report was counted -- see the outcome mapping in index.ts.
    //
    // The reporter's own daily quota lives at players/{uid}/private/reports and is covered by
    // the existing `private` rule, which is why it is not named here.
    // Each subject is its own collection, because each is its own judgement; `reports.ts` owns
    // them and the shape is identical.
    //
    // Named here even though the catch-all at the foot of this file already denies them, and
    // that is not redundancy: a collection nobody has written a rule for reads as a collection
    // nobody thought about, and the next person to add a report subject copies whichever block
    // they can see.
    match /nameReports/{uid} {
      allow read, write: if false;

      match /reporters/{reporterUid} {
        allow read, write: if false;
      }
    }

    match /groveReports/{uid} {
      allow read, write: if false;

      match /reporters/{reporterUid} {
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------ referrals
    // Refer-a-friend (invariant 51). One document per account carrying both halves — the
    // code it holds and the code it typed — one document per code so uniqueness is held by
    // a document id (19d), and one row per invitee under the referrer.
    //
    // Server-only in **both** directions, for the reports' reason. Not client-written: the
    // counts a chest is paid on are counts of *other* accounts' play, and a count the client
    // writes is a chest anybody can pay themselves. Not client-readable: the document names
    // the referrer, and the code owner's document names every invitee — a caller who could
    // read it learns who typed their code, which is more than the feature ever promised
    // anybody. The three callables tell a client only its own state and its own code.
    //
    // Named here even though the catch-all denies them, so the next collection copies a
    // block that says why.
    match /referrals/{uid} {
      allow read, write: if false;

      match /invitees/{inviteeUid} {
        allow read, write: if false;
      }
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------- receipts
    // Keyed globally rather than per player, because the attack is redeeming one
    // real purchase across many accounts. Never readable by a client: knowing which
    // transaction ids exist is itself useful to someone trying to replay them.
    match /receipts/{receiptId} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------- config
    // The reward table and the product catalog. The client reads the reward table so
    // its predictions match the server's arithmetic; it may never write either, since
    // the product catalog is what decides how much a purchase is worth.
    //
    // `get` rather than `read`: every client read here names its document (`groveRanks`,
    // and the two widened below), so `list` was a grant nothing used. A `get` is also what
    // the two public documents below widen — `read` there is `get` and `list` on a single
    // document path, which lists nothing.
    match /config/{document} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // RETIRED 2026-10-07. Was the population's move counts, written nightly by
    // `publishGroveStats`; the function, the document and the client feature are all gone.
    // Kept only because every build shipped before the removal still reads this path from
    // the splash, signed out, and treats an absent document as "nothing to say". Without
    // this block that read is refused instead: harmless too, but not worth a rules release.
    // Delete it once the update wall's minimum excludes those builds.
    //
    // Rules union rather than override, so this widens the read above without touching it.
    match /config/stats {
      allow read:  if true;
      allow write: if false;
    }

    // What the deployment requires of a client, per store: the oldest build still allowed
    // to run, and where to get a newer one. Readable by anybody, signed
    // out: it is the same for everybody, and for a sharper reason than that.
    //
    // A forced update exists precisely because something about an old client no longer works
    // against this deployment - and if that something is ever authentication, a gate behind
    // `signedIn()` is a gate that cannot close on the builds it was written for. It holds no
    // player and no identifier: one minimum and one store link per platform, identical for
    // everybody, fetched before anonymous sign-in has necessarily completed.
    //
    // Never client-writable, and here that is not merely hygiene - a client that could write
    // this could wall every other player out of the game.
    //
    // Rules union rather than override, so this widens the read above without touching it.
    match /config/release {
      allow read:  if true;
      allow write: if false;
    }

    // Anything not named above is denied. New collections have to be granted access
    // deliberately rather than inheriting it by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
