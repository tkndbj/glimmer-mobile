rules_version = '2';

// Glimmer Grove — Firestore security rules.
//
// These rules are the security boundary of the economy. Not the C# client, not the
// Cloud Functions: this file. Everything else can be decompiled, patched or replayed
// by anyone holding the device, so any invariant that matters has to be expressed
// here or on a server the player cannot reach.
//
// The layout exists to make that boundary trivial to audit. The save document and the
// currency ledger are separate documents with separate rules, rather than one document
// whose currency fields have to be diffed field by field on every write. A rule that
// says "this document is server-only" is one line and cannot be got subtly wrong.
//
//   players/{uid}                    the save. Client reads and writes it.
//   players/{uid}/private/wallet     granted and spent baselines. Client reads only.
//   players/{uid}/spendLog/{id}      idempotency records for debits. Client reads only.
//   players/{uid}/grantLog/{id}      idempotency records for awards. Client reads only.
//   receipts/{store}__{txn}          global receipt claims. Client cannot see them.
//   groves/{uid}                     the public grove card. Any player reads, none write.
//   names/{nameKey}                  a reserved keeper name. Any player gets one, none list.
//   nameReports/{uid}/...            who reported whose name. Server-only, both ways.
//   leaderboards/{boardId}           a published board. Any player reads, none write.
//   config/{doc}                     reward table and product catalog. Read-only.
//
// What these rules deliberately do NOT do: validate the contents of the level ledger
// element by element. Firestore rules have no loops, so per-record checks are not
// expressible here. That validation lives in the wallet functions, which recompute
// earned currency from the ledger in TypeScript and ignore anything they cannot
// verify. The consequence is the important one: a player who forges their save can
// change what their own progress screen says, and cannot mint a single credit.
//
// `levels` is a map keyed by level id rather than an array. That makes a duplicated
// record impossible to express rather than something the server has to filter, and it
// lets a sync write `levels.c01_first_light` alone instead of re-uploading a ledger
// that may run to thousands of entries.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------- the save
    match /players/{uid} {

      // Shape checks only. Anything expensive or unbounded is the functions' job.
      function wellFormed() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'schemaVersion', 'updatedUnix', 'settings', 'wallet', 'levels',
                 'progression', 'cloud', 'lastPlayedLevelId', 'legacyImportDone',
                 'tipsSeen', 'daily', 'ads', 'streak', 'events', 'eventsSeeded',
                 'companionsOwned', 'homesteadOwned', 'homesteadPlaced', 'groveLandOwned',
                 'checksum'
               ])
               && d.schemaVersion is int
               && d.schemaVersion >= 1 && d.schemaVersion <= 100
               && d.levels is map
               && d.levels.size() <= 5000
               && (!('lastPlayedLevelId' in d) || d.lastPlayedLevelId is string)
               // Which lessons the player has been shown. Client-owned and harmless —
               // it buys nothing — but bounded anyway, because an unbounded array the
               // client controls is a way to make the document expensive to read.
               && (!('tipsSeen' in d) || (d.tipsSeen is list && d.tipsSeen.size() <= 64))
               // Today's chest counters. Client-owned and forgeable, and that is
               // accounted for: nothing here decides what a chest pays. The server
               // re-rolls each chest itself and refuses a second grant for the same id,
               // so the worst a forged counter buys is a day's chests without playing
               // for them — which is what an honest player gets anyway.
               && (!('daily' in d) || d.daily is map)
               // Today's rewarded-ad allowance. Client-owned and forgeable in exactly the
               // same way, and accounted for in exactly the same way: nothing here decides
               // what an ad paid. That is granted by the server when the ad network's own
               // signed callback arrives, so a forged counter buys another offer and no
               // currency at all. Bounded because the client controls its length.
               && (!('ads' in d) || (d.ads is map
                                     && (!('watched' in d.ads)
                                         || (d.ads.watched is list && d.ads.watched.size() <= 64))))
               // The streak's three dates. Client-owned and forgeable in exactly the same
               // way as the two blocks above, and accounted for in the same way: nothing
               // here decides what a night pays. The ladder does pay currency now, but the
               // server grants it from its own record of the last night it paid — a claim
               // may only advance the night as fast as the calendar advances — so editing
               // these buys a differently-shaped lie and no money. See functions/src/streak.ts.
               && (!('streak' in d) || d.streak is map)
               // How much of each event's reward track the player has taken. Unlike every
               // other client-owned block above, this one *does* reach a payment: a
               // milestone pays only once its floor has reached it, so `eventCredits` reads
               // it. It is still safe to let the client write, because that function clamps
               // the floor to the glades the same derivation counted — a forged one takes
               // early what play had already earned and nothing else. Bounded because the
               // client controls its length. See invariant 13 and EventCollection.
               && (!('events' in d) || (d.events is list && d.events.size() <= 256))
               && (!('eventsSeeded' in d) || d.eventsSeeded is bool)
               // The companions the player bought. Client-owned and forgeable, and that is
               // accounted for rather than overlooked: a forged entry buys a portrait and
               // nothing else — no currency, no progression, no advantage on a board. The
               // money half is defended where money always is, by `submitSpends` refusing a
               // debit the server-derived balance cannot cover, so there is nothing here for
               // the server to adjudicate. Bounded because the client controls its length.
               && (!('companionsOwned' in d) || (d.companionsOwned is list
                                                 && d.companionsOwned.size() <= 256))
               // The grove: what the player bought for it, and where they put it. Both are
               // client-owned and forgeable, and both are still accounted for the same way
               // the companion set above is, with one addition that used to be unnecessary.
               // These three sets are what a grove's public worth is derived from, so since
               // the boards exist a forged entry no longer only buys a picture — it would
               // buy a place on a public list. That is adjudicated in `publishGrove`, which
               // recomputes the score from this document and clamps its bought half to
               // currency the server derived itself, so nothing forged here reaches a board
               // (see functions/src/grove.ts and the `groves` rule below). The money half is
               // defended where money always is, by `submitSpends` refusing a debit the
               // server-derived balance cannot cover. Note what is deliberately
               // absent: any count of how many benches a player owns. Holding a piece is
               // permission to draw it in as many slots as they like, which is why the
               // owned list is a set and cannot go down.
               //
               // Both are bounded because the client controls their length. The placement
               // bound is generous against the shipped 52 slots on purpose: it has to hold
               // for every future content drop as well, and rows naming slots an older
               // build does not know are carried through rather than dropped.
               && (!('homesteadOwned' in d) || (d.homesteadOwned is list
                                                && d.homesteadOwned.size() <= 512))
               && (!('homesteadPlaced' in d) || (d.homesteadPlaced is list
                                                 && d.homesteadPlaced.size() <= 1024))

               // Regions, not tiles — a filled floor is a couple of hundred tiles and a set
               // that size is merged and checksummed on every sync for ever, which is why
               // invariant 16e stores the coarser thing. The cap is generous against that.
               && (!('groveLandOwned' in d) || (d.groveLandOwned is list
                                                && d.groveLandOwned.size() <= 128));
      }

      // The revision only ever moves forward, which gives the sync optimistic
      // concurrency for free. It is >= rather than > so that retrying a push whose
      // response was lost succeeds instead of wedging the device.
      function revisionAdvances() {
        return !('cloud' in resource.data)
               || !('revision' in resource.data.cloud)
               || (request.resource.data.cloud.revision is int
                   && request.resource.data.cloud.revision >= resource.data.cloud.revision);
      }

      // Documents are capped so one account cannot be used to store arbitrary data.
      // A full ledger for a 500-glade catalog is a few tens of kilobytes.
      function withinSize() {
        return request.resource.data.levels.size() <= 5000;
      }

      allow get, list: if isOwner(uid);
      allow create:    if isOwner(uid) && wellFormed() && withinSize();
      allow update:    if isOwner(uid) && wellFormed() && withinSize() && revisionAdvances();

      // Account deletion is a support and compliance operation, never a client call.
      allow delete: if false;

      // --------------------------------------------------- server-owned money
      // The single most important rule in the file. `granted` is what an attacker
      // actually wants: a client that can raise it can print currency, and with real
      // purchases in play that is indistinguishable from stealing revenue. Only the
      // Admin SDK — which these rules do not apply to — may write here.
      match /private/{document} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // Debit idempotency records. Written by the wallet function so that submitting
      // the same spend id twice can only ever charge once.
      match /spendLog/{spendId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // Award idempotency records, written by claimAwards. The id is derived from what
      // earned the award — daily:{day}:{chest}:{currency} — rather than generated, so a
      // second claim from any device, after any reinstall, hits a document that already
      // exists. That, and not any check in the client, is what makes a daily chest
      // payable exactly once.
      match /grantLog/{grantId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
    }

    // ------------------------------------------------------- the public boards
    // A player's grove, as everybody else may see it. This collection exists so that the
    // save document never has to be readable by anyone but its owner: `players/{uid}`
    // holds the level ledger, the streak's dates, the event floors and the ad allowance,
    // and a leaderboard needs a name, a number and where the benches are. Widening the
    // save's read rule to serve that would publish everything else with it and make the
    // save's shape a public API that could never change again.
    //
    // Server-written, without exception. The score on a card is recomputed by
    // `publishGrove` from the save it reads with admin credentials and clamped to currency
    // the server itself derived — see functions/src/grove.ts. Letting a client write here
    // would hand it the leaderboard, because the three id sets a card is built from are
    // client-written and forgeable by design. That was always fine while a forged entry
    // "bought a picture on a screen nobody else sees"; it is this collection that makes
    // that sentence stop being true, which is why it is the one place the client is
    // refused write access to something built entirely out of its own save.
    //
    // Readable by any signed-in player, and only by a signed-in player. It carries a
    // display name, so it is not world-readable the way `config/stats` is — that document
    // holds nine numbers per glade and names nobody, and it is public precisely because
    // the splash needs it before authentication has finished. Nothing here is needed
    // before a player is in the game.
    match /groves/{uid} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // The published boards: one document each, holding up to a hundred rows.
    //
    // Denormalised rather than queried, and that is a cost decision that does not move as
    // the game grows. The obvious shape — order the player collection by score and take
    // the first hundred — is a hundred document reads every time anybody opens the screen,
    // against a collection that grows for the life of the game, on a database billed per
    // read. One document is one read, the same for everybody, and cacheable. It is the
    // same trade `config/stats` already makes.
    match /leaderboards/{boardId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // --------------------------------------------------------- keeper names
    // One document per reserved name, keyed by the name's fold — see functions/src/names.ts.
    //
    // The id *is* the uniqueness. A create against an id that already exists fails, so two
    // players cannot take one name however close together they try, with no index and no
    // scan behind it. The alternative — query the player collection for a matching name and
    // then write — is racy in a way nothing can repair afterwards, and is an index over a
    // collection that grows for the life of the game.
    //
    // `get` and deliberately not `list`. A player may ask whether one name they have typed is
    // free, which is the whole client interaction and is one document read; nobody may walk
    // the collection. That distinction is why the "is this taken" hint costs no function
    // invocation and can be debounced on a keystroke without becoming a bill.
    //
    // Never client-written, even though rules could nearly express it: `create` is already
    // create-if-absent and the uid could be checked against the caller. What rules cannot
    // express is *one name per account*, because that needs the previous reservation released
    // in the same operation and its other half is a document the client itself writes. Without
    // that, one account holds as many names as it cares to pay writes for.
    // A reservation is never released when a name is taken off the boards, only flagged --
    // and the flag lives on the account's wallet rather than here, so this document is exactly
    // what it always was. That is what stops a reported name being handed to the next person
    // who asks for it. See functions/src/reports.ts.
    match /names/{nameKey} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // --------------------------------------------------------- name reports
    // Who has reported whose keeper name, and how many distinct players have.
    //
    // Server-only in **both** directions, which is unusual here and deliberate in each.
    //
    // Not client-written, for the reason `names` is not: the constraint that matters is "one
    // report per player per name", and while an id of `nameReports/{target}/reporters/{caller}`
    // does express exactly that in rules, the *count* the threshold reads cannot be maintained
    // alongside it by a client without letting the client write the count. A takedown decided
    // by a number the client writes is a takedown anybody can trigger. `reportKeeperName` does
    // both halves in one transaction instead, with a per-account daily quota the rules could
    // not express at all.
    //
    // Not client-*readable*, which matters more than it looks. A caller who can see the count
    // can binary-search the threshold and learn exactly how many accounts a brigade needs; a
    // caller who can read the reporter documents learns who reported them, which turns a safety
    // feature into a way of finding somebody to retaliate against. The callable tells a client
    // only whether its own report was counted -- see the outcome mapping in index.ts.
    //
    // The reporter's own daily quota lives at players/{uid}/private/reports and is covered by
    // the existing `private` rule, which is why it is not named here.
    match /nameReports/{uid} {
      allow read, write: if false;

      match /reporters/{reporterUid} {
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------- receipts
    // Keyed globally rather than per player, because the attack is redeeming one
    // real purchase across many accounts. Never readable by a client: knowing which
    // transaction ids exist is itself useful to someone trying to replay them.
    match /receipts/{receiptId} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------- config
    // The reward table and the product catalog. The client reads the reward table so
    // its predictions match the server's arithmetic; it may never write either, since
    // the product catalog is what decides how much a purchase is worth.
    match /config/{document} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // The population's move counts, published by a scheduled job. Readable by anybody,
    // deliberately: it holds no player and no identifier — nine numbers per glade,
    // aggregated over thousands of saves — and the client fetches it from the splash,
    // before anonymous sign-in has necessarily completed. Requiring a session would mean
    // the one screen it feeds could not draw on a first launch, in exchange for
    // protecting a document that is the same for everybody.
    //
    // Rules union rather than override, so this widens the read above without touching it.
    match /config/stats {
      allow read:  if true;
      allow write: if false;
    }

    // Anything not named above is denied. New collections have to be granted access
    // deliberately rather than inheriting it by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
