    { "key": "ui.howto.title", "text": "HOW TO PLAY" },
    { "key": "ui.howto.line1", "text": "Tap a conduit to turn it a quarter step." },
    { "key": "ui.howto.line2", "text": "Guide light from every heart-crystal to the sleeping critters." },
    { "key": "ui.howto.line3", "text": "Hearts joined into one network blend their colours." },
    { "key": "ui.howto.line4", "text": "A critter only wakes to the exact colour it dreams of." },
    { "key": "ui.howto.line5", "text": "Rooted tiles wear a padlock and will not turn." },
    { "key": "ui.howto.line6", "text": "Fewer moves, more stars. There is no timer here." },
