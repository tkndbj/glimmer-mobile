{
  "language": "en",
  "entries": [
    {
      "key": "chapter.c01_shallows.name",
      "text": "The Shallows"
    },
    {
      "key": "level.c01_first_light.name",
      "text": "First Light"
    },
    {
      "key": "level.c01_first_light.tagline",
      "text": "A single heart wakes the glade"
    },
    {
      "key": "level.c01_first_light.lesson",
      "text": "Tap a conduit to turn it. Light every sleeping critter."
    },
    {
      "key": "level.c01_twin_streams.name",
      "text": "Twin Streams"
    },
    {
      "key": "level.c01_twin_streams.tagline",
      "text": "Two hearts, two hues, no mixing"
    },
    {
      "key": "level.c01_twin_streams.lesson",
      "text": "Critters only wake to their own colour. Keep the streams apart."
    },
    {
      "key": "level.c01_prism_heart.name",
      "text": "Prism Heart"
    },
    {
      "key": "level.c01_prism_heart.tagline",
      "text": "Blend the light, wake the deep grove"
    },
    {
      "key": "level.c01_prism_heart.lesson",
      "text": "Joined hearts blend: red plus green makes gold. Keep the blue stream to itself."
    },
    {
      "key": "level.c01_thorn_hollow.name",
      "text": "Brittle Hollow"
    },
    {
      "key": "level.c01_thorn_hollow.tagline",
      "text": "Three streams, and conduits that will not last"
    },
    {
      "key": "level.c01_thorn_hollow.lesson",
      "text": "Some conduits crumble after a few turns. Plan the route before you spin."
    },

    {
      "key": "level.c01_bound_roots.name",
      "text": "Bound Roots"
    },
    {
      "key": "level.c01_bound_roots.tagline",
      "text": "Two streams, and roots that run beneath both"
    },
    {
      "key": "level.c01_bound_roots.lesson",
      "text": "Conduits wearing the same pips share a root. Turn one and its partners turn with it."
    },
    {
      "key": "level.c01_duskcap_hollow.name",
      "text": "Duskcap Hollow"
    },
    {
      "key": "level.c01_duskcap_hollow.tagline",
      "text": "Wake the grove without waking the dark"
    },
    {
      "key": "level.c01_duskcap_hollow.lesson",
      "text": "Duskcaps sleep in the shade. Light one and the glade will not settle, so route around them."
    }, 
    {
      "key": "level.c01_lantern_ring.name",
      "text": "Lantern Ring"
    },
    {
      "key": "level.c01_lantern_ring.tagline",
      "text": "One ring of light around a sleeping dark"
    },
    {
      "key": "level.c01_lantern_ring.lesson",
      "text": "The ring's four corners share one root. Its edges are what can leak light inward."
    },
    {
      "key": "level.c01_sleeping_thicket.name",
      "text": "Sleeping Thicket"
    },
    {
      "key": "level.c01_sleeping_thicket.tagline",
      "text": "Two streams, and a thicket between them"
    },
    {
      "key": "level.c01_sleeping_thicket.lesson",
      "text": "The thicket is the wall keeping the streams apart. Open it and you lose both at once."
    },
    {
      "key": "level.c01_three_springs.name",
      "text": "Three Springs"
    },
    {
      "key": "level.c01_three_springs.tagline",
      "text": "Gold, teal, and a red spring of its own"
    },
    {
      "key": "level.c01_three_springs.lesson",
      "text": "Gold and teal both carry green. Join those two and both go white together."
    },
    {
      "key": "level.c01_grovekeepers_knot.name",
      "text": "The Grovekeeper's Knot"
    },
    {
      "key": "level.c01_grovekeepers_knot.tagline",
      "text": "Everything the grove taught you, at once"
    },
    {
      "key": "level.c01_grovekeepers_knot.lesson",
      "text": "One root reaches into all four corners. Nothing here can be solved a corner at a time."
