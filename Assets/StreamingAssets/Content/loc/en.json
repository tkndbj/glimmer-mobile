    { "key": "chapter.c01_shallows.name", "text": "The Shallows" },

    { "key": "level.c01_first_light.name", "text": "First Light" },
    { "key": "level.c01_first_light.tagline", "text": "A single heart wakes the glade" },
    { "key": "level.c01_first_light.lesson", "text": "Tap a conduit to turn it. Light every sleeping critter." },

    { "key": "level.c01_twin_streams.name", "text": "Twin Streams" },
    { "key": "level.c01_twin_streams.tagline", "text": "Two hearts, two hues, no mixing" },
    { "key": "level.c01_twin_streams.lesson", "text": "Critters only wake to their own colour. Keep the streams apart." },

    { "key": "level.c01_prism_heart.name", "text": "Prism Heart" },
    { "key": "level.c01_prism_heart.tagline", "text": "Blend the light, wake the deep grove" },
    { "key": "level.c01_prism_heart.lesson", "text": "Joined hearts blend: red plus green makes gold. Keep the blue stream to itself." },

    { "key": "level.c01_thorn_hollow.name", "text": "Brittle Hollow" },
    { "key": "level.c01_thorn_hollow.tagline", "text": "Three streams, and conduits that will not last" },
    { "key": "level.c01_thorn_hollow.lesson", "text": "Some conduits crumble after a few turns. Plan the route before you spin." },

