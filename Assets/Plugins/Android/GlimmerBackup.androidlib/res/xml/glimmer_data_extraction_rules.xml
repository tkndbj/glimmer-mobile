<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up splits backup into two transports and `allowBackup` governs only
    one of them. Cloud backup is refused by that attribute; a device to device transfer
    is not, and a new phone is the commonest way this app is ever restored. Both are
    excluded here, so the rule is the same on every Android version.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
