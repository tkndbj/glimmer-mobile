# OS
.DS_Store
Thumbs.db
desktop.ini

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
