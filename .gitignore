# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity's short-path staging dir for the Android external native build: CMake and
# Ninja output, object files and NDK prefab copies, keyed by a per-configuration
# hash. Regenerated by every Android build and referenced only from Library/Bee.
# It was tracked until 2026-08-13, which committed machine-specific absolute paths
# — the copies in here still named the pre-rename project folder.
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db
desktop.ini

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ll]ibrary/com.unity.addressables/aa/*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Regenerated by the Addressables build, which runs as part of the player build
# (m_BuildAddressablesWithPlayerBuild). Tracking it means a file that is dirty after
# every build and eventually gets committed stale, which is worse than absent: it is
# the IL2CPP stripping whitelist, so a stale one strips types the game reflects on.
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml.meta

# Firebase Unity SDK packages: build inputs with a canonical download URL, ~75 MB.
# Committing them would add that to the history on every version bump.
# Restore with: pwsh GooglePackages/fetch.ps1
/GooglePackages/*.tgz

# Firebase
firebase-debug.log
firebase-debug.*.log
.firebase/
/firebase/functions/node_modules/
/firebase/functions/lib/
/firebase/seed/products.json
/firebase/seed/*.local.json

# Firebase config downloaded from the console. google-services.json is not a secret,
# but service-account keys and the Apple .p8 absolutely are, and they land nearby.
*-service-account*.json
*.p8
