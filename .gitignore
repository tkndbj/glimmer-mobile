# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity's short-path staging dir for the Android external native build: CMake and
# Ninja output, object files and NDK prefab copies, keyed by a per-configuration
# hash. Regenerated by every Android build and referenced only from Library/Bee.
# It was tracked until 2026-08-13, which committed machine-specific absolute paths
# — the copies in here still named the pre-rename project folder.
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db
desktop.ini

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ll]ibrary/com.unity.addressables/aa/*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Regenerated by the Addressables build, which runs as part of the player build
# (m_BuildAddressablesWithPlayerBuild). Tracking it means a file that is dirty after
# every build and eventually gets committed stale, which is worse than absent: it is
# the IL2CPP stripping whitelist, so a stale one strips types the game reflects on.
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml.meta

# Firebase Unity SDK packages: build inputs with a canonical download URL, ~75 MB.
# Committing them would add that to the history on every version bump.
# Restore with: pwsh GooglePackages/fetch.ps1
/GooglePackages/*.tgz

# ...except the ads plugin, which is committed deliberately. It is 2 MB rather than 75,
# and it is the one package not served by dl.google.com - OpenUPM is the only source, and
# it answers 404 from some networks while serving the same URL fine from others, which
# left a fresh Mac clone unable to open the project at all. A build input nobody can
# reliably download is not a build input.
!/GooglePackages/com.google.ads.mobile-*.tgz

# Firebase
firebase-debug.log
firebase-debug.*.log
.firebase/
/firebase/functions/node_modules/
/firebase/functions/lib/
/firebase/seed/products.json
/firebase/seed/*.local.json

# Firebase config downloaded from the console. google-services.json is not a secret,
# but service-account keys and the Apple .p8 absolutely are, and they land nearby.
*-service-account*.json
*.p8

# Signing keys. Never in the repository, and never in ProjectSettings either — Unity
# writes a keystore password into ProjectSettings.asset in plain text the moment it is
# typed into Publishing Settings, and that file is committed. The store build reads its
# credentials from the environment instead; see DevBuild.KeystoreEnv.
*.keystore
*.jks

# The generated Xcode project. Unity rewrites this whole tree on every iOS build
# (Classes/, Data/, Libraries/, Il2CppOutputProject/, Frameworks/), CocoaPods writes
# Pods/ and the .xcworkspace into it, and the Firebase editor script copies
# GoogleService-Info.plist in. It is ~1 GB, it is a pure function of the project plus
# the two resolver steps, and nothing in it is authored — so committing it means a
# gigabyte of churn per build and a stale copy that eventually gets opened by mistake.
# Regenerate with: Build Profiles > iOS > Build (the workspace is produced by the
# post-build CocoaPods step; see IosWorkspaceGuard).
/glimmer-ios-builds/

# Python bytecode from the Tools scripts. They are run in place, so the caches land
# beside the sources; none of it is content and none of it is checked.
__pycache__/
*.pyc
