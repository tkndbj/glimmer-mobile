# Line endings are pinned here rather than left to each machine's core.autocrlf,
# because a project built on both Windows and macOS otherwise gets phantom diffs:
# ProjectSettings.asset once came back as 997 changed lines that were purely CRLF,
# which buries a real one-line change in noise and makes review useless.
#
# LF everywhere. Unity writes LF on every platform and reads either, so there is no
# reason for a working copy to differ from what is stored.
* text=auto eol=lf

# Unity's YAML assets. Called out explicitly so they can never be treated as binary
# by a heuristic — a misdetected .asset is one nobody can diff or merge.
*.asset    text eol=lf
*.meta     text eol=lf
*.unity    text eol=lf
*.prefab   text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.spriteatlas   text eol=lf
*.spriteatlasv2 text eol=lf

# Source and data.
*.cs   text eol=lf diff=csharp
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.mm   text eol=lf
*.h    text eol=lf
*.asmdef text eol=lf
*.gradle text eol=lf

# Shell scripts must stay LF or they will not run; .ps1 is Windows-only, so CRLF.
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binaries: never touched, never diffed.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.tga  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.dll  binary
*.so   binary
*.a    binary
*.dylib binary
*.tgz  binary
*.zip  binary
*.unitypackage binary
*.aar  binary
*.jar  binary
*.bundle binary
*.bin  binary
