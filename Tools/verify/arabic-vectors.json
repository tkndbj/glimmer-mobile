{
  "schemaVersion": 1,
  "about": [
    "Arabic shaping and ordering, written down once and run by both copies of it:",
    "ArabicText.cs (ArabicTextTests) and Tools/arabic_text.py (--check).",
    "Each expected answer is written by hand from the Unicode rules, never generated by",
    "either copy. Code points ride alongside the text because JsonUtility truncates a",
    "string at an escape; the C# side reads only the codes."
  ],
  "cases": [
    {
      "name": "lone letter",
      "rule": "shape",
      "why": "a letter with no neighbours is isolated",
      "text": "ب",
      "textCodes": [
        1576
      ],
      "expected": "ﺏ",
      "expectedCodes": [
        65167
      ]
    },
    {
      "name": "pair",
      "rule": "shape",
      "why": "a dual-joining pair is initial then final",
      "text": "بب",
      "textCodes": [
        1576,
        1576
      ],
      "expected": "ﺑﺐ",
      "expectedCodes": [
        65169,
        65168
      ]
    },
    {
      "name": "triple",
      "rule": "shape",
      "why": "the middle letter joins both ways",
      "text": "ببب",
      "textCodes": [
        1576,
        1576,
        1576
      ],
      "expected": "ﺑﺒﺐ",
      "expectedCodes": [
        65169,
        65170,
        65168
      ]
    },
    {
      "name": "alef breaks the word",
      "rule": "shape",
      "why": "alef joins only to the letter before it, so the next letter starts afresh",
      "text": "باب",
      "textCodes": [
        1576,
        1575,
        1576
      ],
      "expected": "ﺑﺎﺏ",
      "expectedCodes": [
        65169,
        65166,
        65167
      ]
    },
    {
      "name": "lam-alef alone",
      "rule": "shape",
      "why": "lam then alef is one glyph, never two",
      "text": "لا",
      "textCodes": [
        1604,
        1575
      ],
      "expected": "ﻻ",
      "expectedCodes": [
        65275
      ]
    },
    {
      "name": "lam-alef joined",
      "rule": "shape",
      "why": "after a joining letter the ligature takes its final form",
      "text": "سلا",
      "textCodes": [
        1587,
        1604,
        1575
      ],
      "expected": "ﺳﻼ",
      "expectedCodes": [
        65203,
        65276
      ]
    },
    {
      "name": "lam-alef hamza",
      "rule": "shape",
      "why": "each of the four alefs fuses with lam",
      "text": "لأ",
      "textCodes": [
        1604,
        1571
      ],
      "expected": "ﻷ",
      "expectedCodes": [
        65271
      ]
    },
    {
      "name": "harakat dropped",
      "rule": "shape",
      "why": "a mark cannot be stacked by the renderer and is transparent to joining",
      "text": "بَب",
      "textCodes": [
        1576,
        1614,
        1576
      ],
      "expected": "ﺑﺐ",
      "expectedCodes": [
        65169,
        65168
      ]
    },
    {
      "name": "tatweel joins",
      "rule": "shape",
      "why": "tatweel carries the join through itself",
      "text": "بـب",
      "textCodes": [
        1576,
        1600,
        1576
      ],
      "expected": "ﺑـﺐ",
      "expectedCodes": [
        65169,
        1600,
        65168
      ]
    },
    {
      "name": "zwnj breaks",
      "rule": "shape",
      "why": "a zero-width non-joiner stops the join and is consumed",
      "text": "ب‌ب",
      "textCodes": [
        1576,
        8204,
        1576
      ],
      "expected": "ﺏﺏ",
      "expectedCodes": [
        65167,
        65167
      ]
    },
    {
      "name": "hamza stands alone",
      "rule": "shape",
      "why": "hamza does not join and passes through unchanged",
      "text": "بءب",
      "textCodes": [
        1576,
        1569,
        1576
      ],
      "expected": "ﺏءﺏ",
      "expectedCodes": [
        65167,
        1569,
        65167
      ]
    },
    {
      "name": "number after word",
      "rule": "visual",
      "why": "digits keep their own order inside a right-to-left line",
      "text": "ب 12",
      "textCodes": [
        1576,
        32,
        49,
        50
      ],
      "expected": "12 ﺏ",
      "expectedCodes": [
        49,
        50,
        32,
        65167
      ]
    },
    {
      "name": "latin with its number",
      "rule": "visual",
      "why": "digits after Latin are Latin, and the space between stays inside the run",
      "text": "ب Level 5",
      "textCodes": [
        1576,
        32,
        76,
        101,
        118,
        101,
        108,
        32,
        53
      ],
      "expected": "Level 5 ﺏ",
      "expectedCodes": [
        76,
        101,
        118,
        101,
        108,
        32,
        53,
        32,
        65167
      ]
    },
    {
      "name": "sign joins the number",
      "rule": "visual",
      "why": "a sign before a digit stays before it",
      "text": "ب +20",
      "textCodes": [
        1576,
        32,
        43,
        50,
        48
      ],
      "expected": "+20 ﺏ",
      "expectedCodes": [
        43,
        50,
        48,
        32,
        65167
      ]
    },
    {
      "name": "percent joins the number",
      "rule": "visual",
      "why": "a percent sign after a digit stays after it",
      "text": "50% ب",
      "textCodes": [
        53,
        48,
        37,
        32,
        1576
      ],
      "expected": "ﺏ 50%",
      "expectedCodes": [
        65167,
        32,
        53,
        48,
        37
      ]
    },
    {
      "name": "grouped thousands",
      "rule": "visual",
      "why": "a separator between digits is part of the number",
      "text": "1,240 ب",
      "textCodes": [
        49,
        44,
        50,
        52,
        48,
        32,
        1576
      ],
      "expected": "ﺏ 1,240",
      "expectedCodes": [
        65167,
        32,
        49,
        44,
        50,
        52,
        48
      ]
    },
    {
      "name": "fraction",
      "rule": "visual",
      "why": "a slash between digits is part of the number",
      "text": "ب 3/5",
      "textCodes": [
        1576,
        32,
        51,
        47,
        53
      ],
      "expected": "3/5 ﺏ",
      "expectedCodes": [
        51,
        47,
        53,
        32,
        65167
      ]
    },
    {
      "name": "brackets mirror",
      "rule": "visual",
      "why": "a bracket in right-to-left text is drawn mirrored, so it still opens on the right",
      "text": "(ب)",
      "textCodes": [
        40,
        1576,
        41
      ],
      "expected": "(ﺏ)",
      "expectedCodes": [
        40,
        65167,
        41
      ]
    },
    {
      "name": "two words",
      "rule": "visual",
      "why": "words read right to left, and inside a word the first letter is drawn rightmost",
      "text": "بب ب",
      "textCodes": [
        1576,
        1576,
        32,
        1576
      ],
      "expected": "ﺏ ﺐﺑ",
      "expectedCodes": [
        65167,
        32,
        65168,
        65169
      ]
    },
    {
      "name": "lines stay in order",
      "rule": "visual",
      "why": "each line is reordered on its own and the first line stays first",
      "text": "ب\nبب",
      "textCodes": [
        1576,
        10,
        1576,
        1576
      ],
      "expected": "ﺏ\nﺐﺑ",
      "expectedCodes": [
        65167,
        10,
        65168,
        65169
      ]
    },
    {
      "name": "latin untouched",
      "rule": "visual",
      "why": "a string with no Arabic is never changed",
      "text": "Level 5",
      "textCodes": [
        76,
        101,
        118,
        101,
        108,
        32,
        53
      ],
      "expected": "Level 5",
      "expectedCodes": [
        76,
        101,
        118,
        101,
        108,
        32,
        53
      ]
    }
  ]
}
